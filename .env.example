# Copie para .env na raiz do repositorio. Nunca commite valores reais.
# Todas as variaveis do backend usam o prefixo AGENTATHON_.

# Servidor (modo local: apenas loopback, workspace unico sem autenticacao)
AGENTATHON_HOST=127.0.0.1
AGENTATHON_PORT=8000
AGENTATHON_DATA_DIR=./data
# AGENTATHON_DATABASE_URL=sqlite+aiosqlite:///./data/agentathon.db

# Autenticacao para exposicao em rede: AGENTATHON_AUTH_MODE=token e tokens no formato token:owner,token2:owner2
AGENTATHON_AUTH_MODE=local
AGENTATHON_API_TOKENS=

# Integracao NeuraLake (modo real). Sem a chave, o modo real fica indisponivel e o modo simulado continua utilizavel.
AGENTATHON_NEURALAKE_API_KEY=
AGENTATHON_NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
# Senha exigida para criar execucoes no modo real (protege os creditos quando o site e publico).
AGENTATHON_REAL_MODE_PASSWORD=
# Precos versionados (JSON) para permitir orcamento estrito em modo real. Sem arquivo, precos ficam "unknown".
# AGENTATHON_NEURALAKE_PRICES_FILE=./fixtures/prices/neuralake.example.json

# Limites do servidor
AGENTATHON_MAX_UPLOAD_MB=10
AGENTATHON_MAX_PDF_PAGES=100
AGENTATHON_SERVER_MAX_DEADLINE_S=600

# Frontend (Next.js) — URL do backend consumido pelo navegador
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
